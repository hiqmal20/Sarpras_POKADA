{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "be": {
      "root": "BE",
      "framework": "express",
      "entrypoint": "app.js"
    },
    "fe": {
      "root": "FE",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "be",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "fe"
      }
    }
  ]
}
