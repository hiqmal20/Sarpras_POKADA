# ==============================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================

# URL API Backend Render / Railway (bisa dengan atau tanpa /api di akhir)
# Contoh Render: https://sarpras-pokada.onrender.com/api
# Contoh Railway: https://sarpras-backend-production.up.railway.app/api
NEXT_PUBLIC_API_URL=https://sarpras-pokada.onrender.com/api

# URL WebSocket Socket.IO (domain backend TANPA /api)
# Contoh: https://sarpras-pokada.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://sarpras-pokada.onrender.com

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (HANYA gunakan anon public key, JANGAN service_role!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
