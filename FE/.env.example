# ==============================================================
# VERCEL FRONTEND ENVIRONMENT VARIABLES (.env)
# ==============================================================

# URL API Backend Railway (akhiri dengan /api)
# Contoh: https://sarpras-backend-production.up.railway.app/api
NEXT_PUBLIC_API_URL=https://your-railway-app.up.railway.app/api

# URL WebSocket Socket.IO Railway (sama dengan domain Railway, TANPA /api)
# Contoh: https://sarpras-backend-production.up.railway.app
NEXT_PUBLIC_SOCKET_URL=https://your-railway-app.up.railway.app

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (HANYA gunakan anon public key, JANGAN service_role!)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
