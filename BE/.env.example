PORT=5000

# Ambil dari: Supabase Dashboard → Settings → API
# WAJIB menggunakan format: https://xxxxx.supabase.co (TANPA /rest/v1/)
SUPABASE_URL=https://your-project-id.supabase.co

# HARUS menggunakan "service_role" key (bukan "anon" key)
# Supabase Dashboard → Settings → API → Project API keys → service_role (klik Reveal)
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIi...
SUPABASE_KEY=your_service_role_key_here

# Origins yang diizinkan (frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
