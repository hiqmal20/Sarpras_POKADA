# ==============================================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway / Production)
# ==============================================================

# Port disediakan otomatis oleh Render/Railway, default ke 5000 untuk lokal
PORT=5000

# Mode aplikasi: ganti ke 'production' saat hosting di Render atau Railway
NODE_ENV=production

# Supabase URL (ambil dari Supabase Dashboard -> Project Settings -> API)
# Format: https://xxxx.supabase.co (TANPA slash di akhir)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (HARUS service_role key, BUKAN anon key!)
# Ambil dari: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_KEY=your_service_role_secret_key_here

# Domain Frontend yang diizinkan untuk CORS & Cookies (pisahkan dengan koma)
# Masukkan domain Vercel Anda dan domain localhost untuk testing
# Catatan: Secara default https://*.vercel.app dan http://localhost:3000 sudah otomatis diizinkan.
# Anda juga bisa menggunakan nama variabel FRONTEND_URL atau CORS_ORIGIN.
ALLOWED_ORIGINS=https://sarpras-pokada.vercel.app,https://*.vercel.app,http://localhost:3000
